{
  "manifest_version": 3,
  "name": "BarPilot",
  "version": "0.2.0",
  "description": "Per-site Bookmarks Bar profiles (safe + recoverable).",
  "permissions": ["bookmarks", "tabs", "storage", "alarms"],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "BarPilot",
    "default_popup": "popup.html"
  },
  "commands": {
    "toggle-lock": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "Toggle BarPilot Lock (freeze switching)"
    },
    "toggle-enabled": {
      "suggested_key": {
        "default": "Alt+Shift+E"
      },
      "description": "Toggle BarPilot Enabled"
    },
    "rerender-now": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Re-render now"
    }
  }
}
